# The camera app switched between the cameras with time to settle in between:
# rear -> front -> rear -> front, then the rear again. Every handover is in the
# kernel log (the sessions' start and stop), and the last stretch shows whether
# the exposure and the lens settle and stay put.
/redwood/bin/rwtouch wait 20 tap 0.5 0.5 wait 2 notify com.hakios.unlock wait 2 swipe 0.5 0.985 0.5 0.3 200 wait 2
/var/jb/usr/bin/uiopen --bundleid com.apple.camera
/redwood/bin/rwtouch wait 20 tap 0.886 0.871 wait 15 tap 0.886 0.871 wait 15 tap 0.886 0.871 wait 15 tap 0.886 0.871 wait 15
