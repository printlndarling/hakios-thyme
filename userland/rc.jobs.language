# Language gate: start SpringBoard and open the language/region pane for a
# physical switch test against the retained zh-Hans/zh-Hant resources.
/redwood/bin/sound_test springboard
/redwood/bin/battery_test open prefs:root=General&path=INTERNATIONAL
/redwood/bin/rwtouch wait 4 tap 0.23 0.276
/redwood/bin/rwtouch wait 2 tap 0.42 0.52
/redwood/bin/rwtouch wait 2 tap 0.50 0.776
