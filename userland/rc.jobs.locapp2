# LocProbe with the consent alert answered (RC_JOBS=rc.jobs.locapp2): the master switch on,
# the probe registered and opened, then one tap on "Allow While Using App" at the place the
# 16:46 run's screenshot puts it (0.5, 0.694 of the screen), a minute for locationd to deliver,
# and the application's log to the console from the world-writable directory the scene made.
# What the tap can hit is what the screenshot showed: Allow Once above it, Don't Allow below.
/redwood/bin/sleep_hold 300 &
/var/jb/usr/bin/uiopen sileo://package/wget
/redwood/bin/rwtouch wait 15
/redwood/bin/loc_test enable
/redwood/bin/rwtouch wait 3
/redwood/bin/killby locationd 15
/redwood/bin/rwtouch wait 4
/var/jb/usr/bin/mkdir -p /var/jb/locprobe
/var/jb/usr/bin/chmod 777 /var/jb/locprobe
/var/jb/usr/bin/mkdir -p /var/jb/Applications
/var/jb/usr/bin/cp -R /redwood/fw/locprobe/LocProbe.app /var/jb/Applications/
/var/jb/usr/bin/uicache -a
/var/jb/usr/bin/uiopen hakiosloc://
/redwood/bin/rwtouch wait 12
/redwood/bin/rwtouch tap 0.5 0.694
/redwood/bin/rwtouch wait 60
/var/jb/usr/bin/cat /var/jb/locprobe/locprobe.log
/var/jb/usr/bin/find /private/var/mobile/Containers/Data/Application -name locprobe.log -exec /var/jb/usr/bin/cat {} ;
