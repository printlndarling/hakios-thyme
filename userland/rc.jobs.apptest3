# RC_JOBS=rc.jobs.apptest3: third-party apps installed the way LocProbe is -- copied into the
# package manager's Applications dir and registered with uicache -- then opened in turn.  The app
# bundles ride in the system image (/Applications, from the package manager's prefix at build time);
# the RAM payload is too small for them beside the kernel (a 56 MB root image failed to upload).
/redwood/bin/rwtouch wait 20
/var/jb/usr/bin/mkdir -p /var/jb/Applications
/var/jb/usr/bin/cp -R /Applications/TrollStore.app /var/jb/Applications/ >> /private/var/tmp/apps2.txt 2>&1
/var/jb/usr/bin/cp -R /Applications/iSH.app /var/jb/Applications/ >> /private/var/tmp/apps2.txt 2>&1
/var/jb/usr/bin/ls -l /var/jb/Applications >> /private/var/tmp/apps2.txt 2>&1
/var/jb/usr/bin/uicache -a >> /private/var/tmp/apps2.txt 2>&1
/redwood/bin/rwtouch wait 10
/var/jb/usr/bin/uiopen --bundleid com.opa334.TrollStore >> /private/var/tmp/apps2.txt 2>&1
/redwood/bin/rwtouch wait 60
/var/jb/usr/bin/uiopen --bundleid app.ish.iSH >> /private/var/tmp/apps2.txt 2>&1
/redwood/bin/rwtouch wait 40
/var/jb/usr/bin/cat /private/var/tmp/apps2.txt
sleep 25
/var/jb/usr/bin/cat /private/var/tmp/apps2.txt
sleep 25
/var/jb/usr/bin/cat /private/var/tmp/apps2.txt
