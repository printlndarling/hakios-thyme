# Commands run by the launchd job com.hakios.demo (see com.hakios.demo.plist).
# Sileo, the package manager (RC_JOBS=rc.jobs.sileo): the prefix is grafted onto /var/jb by init
# (tools/mk-jb.sh puts it in the image). The preparation the bootstrap wants once per boot, the
# network (Wi-Fi has an address and a name resolves: before that, apt finds no repository), a fresh
# index, the half minute LaunchServices wants before it registers the prefix's applications (with the root
# on the flash: prep.sh, uicache), and then the whole way a person goes: the package's own page is opened by URL (no typing),
# GET puts it in the queue, and Sileo's queue is the popup bar above the tab bar.
#
# 2026-11-12, from Sileo's own source (github.com/Sileo/Sileo): the QUEUE button only
# calls DownloadManager.add(package, queue: .installations); the queue is the
# LNPopupController popup bar the TabBarController shows when operationCount() > 0
# (TabBarController.updatePopup), and tapping the bar presents
# DownloadsTableViewController, whose confirmButton is the "Confirm" step. The bar
# sits above the tab bar, so the package page -- presented as a page sheet -- has
# to go first: a drag from its grabber row dismisses it, while a drag from the
# header scrolls the page instead (the 2026-11-08 runs and this evening's
# timeline run both dragged the header and the sheet stayed). The grabber row
# measures y 0.060 of the screen in the timeline screenshots; 0.033 is above the
# card entirely and does nothing.
/var/jb/bin/sh /var/jb/prep.sh
/redwood/bin/net_test wait 120 joinfile /redwood/fw/network
/redwood/bin/net_test joinfile /redwood/fw/network
/redwood/bin/net_test waitaddr en0 60 resolve apt.procurs.us
/var/jb/usr/bin/apt-get update
# Sileo reads <repo>_Release for the repository's name and apt writes
# <repo>_InRelease; without the former the page shows "Untitled Repo" and the
# queue path loses its source. The seed copies apt's bytes under Sileo's name
# (userland/sileo-seed.sh, staged in /redwood/bin).
/var/jb/bin/sh /redwood/bin/sileo-seed.sh
/redwood/bin/rwtouch wait 25 swipe 0.5 0.985 0.5 0.3 200 wait 6
/var/jb/usr/bin/uiopen sileo://package/tree
# a cold launch can stay in the background (the 21:04 run's pid lived but the
# home screen was in front): ask again. The permission alert's moment depends
# on when the page actually loads (the 21:52 run's alert was up five minutes
# after boot, after every fixed tap had passed), so a background line taps its
# "Don't Allow" every few seconds for two and a half minutes while the page
# loads; once the alert is gone those taps land on the description text, which
# does nothing.
/redwood/bin/rwtouch wait 15 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 &
/redwood/bin/rwtouch wait 145 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4 &
/redwood/bin/rwtouch wait 12
/var/jb/usr/bin/uiopen sileo://package/tree
# the alert is dismissed by the two background lines (the whole page-load
# window); the page has long loaded by now. 130 s keeps the whole scene inside
# the battery guard's reach at a low charge (it ended a 600 s run at 25 % after
# 316 s, before the final dpkg-query)
/redwood/bin/rwtouch wait 130
# GET -> QUEUE. The tap is repeated: an already-queued button only presents the
# popup and reloads (PackageQueueButton.buttonTapped), it does not unqueue, so a
# tap that lands on a late permission alert (and dismisses it) costs nothing and
# the next one lands on the button.
/redwood/bin/rwtouch tap 0.86 0.37 wait 5 tap 0.86 0.37 wait 5 tap 0.86 0.37 wait 5 tap 0.86 0.37 wait 5 tap 0.86 0.37 wait 5 tap 0.86 0.37 wait 5
# close the package sheet: a drag from the grabber itself (y 0.060, measured; the header
# below it belongs to the scrolling page), twice
/redwood/bin/rwtouch swipe 0.5 0.060 0.5 0.80 500 wait 6
/redwood/bin/rwtouch swipe 0.5 0.060 0.5 0.85 700 wait 6
# the queue's popup bar above the tab bar
/redwood/bin/rwtouch tap 0.5 0.862 wait 12
/var/jb/bin/cat /var/jb/var/log/apt/term.log
/var/jb/usr/bin/dpkg-query -W -f${binary:Package}_${Version}_${Status}\n tree
/var/jb/usr/bin/tree -L 1 /var/jb
