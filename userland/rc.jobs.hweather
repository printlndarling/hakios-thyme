# HWEATHER (RC_JOBS=rc.jobs.hweather): the native weather screen, installed
# and opened the way LocProbe is.  The stock Weather app stops at WeatherKit's
# FairPlay token (CHECKLIST, "Weather: the app's own fairplayd gate"); this
# application asks Open-Meteo instead, and wttr.in over plain HTTP when the
# port's TLS to Open-Meteo stalls.  The scene joins the network beside it and
# waits 35 s before opening, so the first fetch has a link.
/redwood/bin/net_test wait 20 joinfile /redwood/fw/network &
/redwood/bin/sleep_hold 300 &
/var/jb/usr/bin/mkdir -p /var/jb/hweather
/var/jb/usr/bin/chmod 777 /var/jb/hweather
/var/jb/usr/bin/mkdir -p /var/jb/Applications
/var/jb/usr/bin/cp -R /redwood/fw/hweather/HakiosWeather.app /var/jb/Applications/
/var/jb/usr/bin/ls -l /var/jb/Applications/HakiosWeather.app/
/var/jb/usr/bin/uicache -a
/redwood/bin/rwtouch wait 35
# mDNSResponder's answer and a TCP connect beside the app, for the -1001 logs
/redwood/bin/net_test resolve api.open-meteo.com
/redwood/bin/net_test tcp api.open-meteo.com 443
# the URL scheme's registration is not always ready when the bundle is;
# the bundle id is what LaunchServices knows
/var/jb/usr/bin/uiopen --bundleid com.hakios.weather
/redwood/bin/rwtouch wait 20
/var/jb/usr/bin/uiopen --bundleid com.hakios.weather
/redwood/bin/rwtouch wait 12
/redwood/bin/rwtouch tap 0.5 0.60
/redwood/bin/rwtouch wait 3
/redwood/bin/rwtouch tap 0.5 0.694
/redwood/bin/rwtouch wait 100
/var/jb/usr/bin/cat /var/jb/hweather/weather.log
