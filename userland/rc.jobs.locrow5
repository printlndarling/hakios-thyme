# Whether the Location Services row appears once the subsystem is live (RC_JOBS=rc.jobs.locrow5):
# turn the switch on, register and open LocProbe, answer its alert, let locationd deliver fixes for
# a minute, and only then open Privacy & Security for the shots. No Sileo.
/redwood/bin/sleep_hold 250 &
/redwood/bin/rwtouch wait 10
/redwood/bin/loc_test enable
/redwood/bin/rwtouch wait 3
/redwood/bin/killby locationd 15
/redwood/bin/rwtouch wait 4
/var/jb/usr/bin/mkdir -p /var/jb/locprobe
/var/jb/usr/bin/chmod 777 /var/jb/locprobe
/var/jb/usr/bin/mkdir -p /var/jb/Applications
/var/jb/usr/bin/cp -R /redwood/fw/locprobe/LocProbe.app /var/jb/Applications/
/var/jb/usr/bin/uicache -a
/var/jb/usr/bin/uiopen hakiosloc://
/redwood/bin/rwtouch wait 12
/redwood/bin/rwtouch tap 0.5 0.694
/redwood/bin/rwtouch wait 60
/var/jb/usr/bin/uiopen prefs:root=Privacy&path=LOCATION
/redwood/bin/rwtouch wait 8
/redwood/bin/rwtouch swipe 0.5 0.35 0.5 0.9 300
/redwood/bin/rwtouch wait 5
/redwood/bin/rwtouch swipe 0.5 0.35 0.5 0.9 300
/redwood/bin/rwtouch wait 40
