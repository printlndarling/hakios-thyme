# Scroll the Wi-Fi network list: repeated UIScrollView swipes make the
# display link's frame pacing visible in the window server's tl: timestamps
# and in the hakios-gl frame log.
/redwood/bin/sound_test springboard
/redwood/bin/battery_test open prefs:root=WIFI
/redwood/bin/rwtouch wait 12
/redwood/bin/rwtouch swipe 0.5 0.8 0.5 0.2 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.2 0.5 0.8 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.8 0.5 0.2 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.2 0.5 0.8 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.8 0.5 0.2 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.2 0.5 0.8 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.8 0.5 0.2 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.2 0.5 0.8 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.8 0.5 0.2 300
/redwood/bin/rwtouch wait 1
/redwood/bin/rwtouch swipe 0.5 0.2 0.5 0.8 300
/redwood/bin/rwtouch wait 1
