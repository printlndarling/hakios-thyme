# Commands run by the launchd job com.hakios.demo (RC_JOBS=rc.jobs.langtest).
# Sileo opened; its notification alert dismissed ("Don't Allow"), its settings sheet opened by
# the avatar (top right), and the sheet scrolled down to where the language rows are. The runner
# is devices/thyme/launchtest.sh (SCENE=out/thyme-boot/root-langtest.apfs), a screenshot every
# two seconds, to find the Change Language row's coordinates before the language taps are
# scripted.
/redwood/bin/rwtouch wait 30 swipe 0.5 0.985 0.5 0.3 200 wait 6
/var/jb/usr/bin/uiopen sileo://package/tree
/redwood/bin/rwtouch wait 25 tap 0.32 0.601 wait 4 tap 0.32 0.601 wait 4
/redwood/bin/rwtouch tap 0.9 0.14 wait 12 swipe 0.5 0.8 0.5 0.3 300 wait 2 swipe 0.5 0.8 0.5 0.3 300 wait 2
/redwood/bin/rwtouch wait 30
