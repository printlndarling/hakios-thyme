# Location with the Wi-Fi link actually up (RC_JOBS=rc.jobs.locfinal, built with
# OSLOG=com.apple.locationd): join the network the way the scenes that carry traffic do
# (net_test joinfile), see what SystemConfiguration and the sockets say now, turn the switch
# on, register and open LocProbe (Sileo first so LaunchServices is settled), answer its
# consent alert with one tap, and give locationd two minutes for its ALS query and its answer.
/redwood/bin/sleep_hold 300 &
/redwood/bin/rwtouch wait 10
/redwood/bin/net_test joinfile /redwood/fw/network
/redwood/bin/reach_test
/redwood/bin/loc_test enable
/redwood/bin/rwtouch wait 3
/redwood/bin/killby locationd 15
/redwood/bin/rwtouch wait 4
/var/jb/usr/bin/mkdir -p /var/jb/locprobe
/var/jb/usr/bin/chmod 777 /var/jb/locprobe
/var/jb/usr/bin/mkdir -p /var/jb/Applications
/var/jb/usr/bin/cp -R /redwood/fw/locprobe/LocProbe.app /var/jb/Applications/
/var/jb/usr/bin/uicache -a
/var/jb/usr/bin/uiopen sileo://package/wget
/redwood/bin/rwtouch wait 10
/var/jb/usr/bin/uiopen hakiosloc://
/redwood/bin/rwtouch wait 12
/redwood/bin/rwtouch tap 0.5 0.694
/redwood/bin/rwtouch wait 120
/var/jb/usr/bin/cat /var/jb/locprobe/locprobe.log
