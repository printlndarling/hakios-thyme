# RC_JOBS=rc.jobs.mapqemu: rc.jobs.mapapp plus the network, for a QEMU boot (CONFIGD=1).
#
# A QEMU virtio network comes up as en0 with no address until someone asks for DHCP; on the phone
# Wi-Fi joins and is configured by the system, so this scene is never used there.  configd carries
# the IPConfiguration plugin that does the asking ("net_test dhcp en0"), and the two TCP lines say
# whether the outside world is reachable before the app is opened.  Everything else is mapapp.
/redwood/bin/rwtouch wait 35
/redwood/bin/net_test dhcp en0
/redwood/bin/rwtouch wait 8
/redwood/bin/net_test resolve tile.openstreetmap.org
/redwood/bin/net_test tcp tile.openstreetmap.org 443
/redwood/bin/net_test tcp nominatim.openstreetmap.org 443
/var/jb/usr/bin/mkdir -p /var/jb/Applications /var/jb/hmaps
/var/jb/usr/bin/chmod 777 /var/jb/hmaps
/var/jb/bin/echo 西安大雁塔 >> /private/var/tmp/hmaps-search.txt
/var/jb/usr/bin/cp -R /redwood/fw/hmaps/HakiosMaps.app /var/jb/Applications/
/var/jb/usr/bin/chmod 755 /var/jb/Applications/HakiosMaps.app/HakiosMaps
/var/jb/usr/bin/uicache -p /var/jb/Applications/HakiosMaps.app >> /var/jb/hmaps/install.log
/var/jb/usr/bin/uicache -i com.hakios.maps >> /var/jb/hmaps/install.log
# A deliberately unusable tile source: the app's own log line says which URL it will use, so the
# tiles.conf path is proven even though this network cannot reach any tile server (see below).
/var/jb/bin/echo tile_url=https://example.invalid/{z}/{x}/{y}.png >> /var/jb/hmaps/tiles.conf
/redwood/bin/rwtouch wait 10
/var/jb/usr/bin/uiopen --bundleid com.hakios.maps
/redwood/bin/rwtouch wait 60
/var/jb/usr/bin/cat /var/jb/hmaps/install.log
/var/jb/usr/bin/cat /private/var/tmp/hmaps.log
sleep 30
/var/jb/usr/bin/cat /private/var/tmp/hmaps.log
