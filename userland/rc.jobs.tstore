# RC_JOBS=rc.jobs.tstore: TrollStore installs an IPA, with the log on the console.
#
# First the helper directly (it is the program TrollStore's UI spawns with a root persona):
#   trollstorehelper install custom <ipa>
# runs as root here, prints every step with NSLog (which reaches the console because this job's
# stderr is the console), and does the real work: sign, MCM app container, LS registration.
# Then the UI path, for the hand-off as well: the IPA opened as a file URL with uiopen --url goes
# to TrollStore (the only app that claims com.apple.itunes.ipa; TSSceneDelegate handleURLContexts:),
# and with installAlertConfiguration = 2 it installs without asking (TSInstallationController
# presentInstallationAlertIfEnabledForFile:).  Two rounds of the same install are harmless: the
# second finds the app installed and bails with its own message.
#
# The app being installed is the LocProbe bundle packed by tools/ipa.py; when it appears and opens,
# TrollStore's IPA path works on this port.
/redwood/bin/rwtouch wait 35
/var/jb/bin/sh /redwood/bin/hk-appinstall.sh TrollStore.app com.opa334.TrollStore
/var/jb/usr/bin/mkdir -p /var/mobile/Library/Preferences
/var/jb/usr/bin/cp /redwood/share/trollstore/com.opa334.TrollStore.plist /var/mobile/Library/Preferences/
/var/jb/usr/bin/chown 501:501 /var/mobile/Library/Preferences/com.opa334.TrollStore.plist
/var/jb/usr/bin/chmod 644 /var/mobile/Library/Preferences/com.opa334.TrollStore.plist
/var/jb/usr/bin/cp /redwood/fw/ipa/LocProbe.ipa /private/var/tmp/LocProbe.ipa
/var/jb/usr/bin/chmod 644 /private/var/tmp/LocProbe.ipa
/redwood/bin/rwtouch wait 3
/var/jb/Applications/TrollStore.app/trollstorehelper install custom /private/var/tmp/LocProbe.ipa
/redwood/bin/rwtouch wait 20
/var/jb/usr/bin/ls -l /var/containers/Bundle/Application >> /private/var/tmp/tstore.txt
/var/jb/usr/bin/uicache -a
/var/jb/usr/bin/uiopen --bundleid com.hakios.locprobe
/redwood/bin/rwtouch wait 30
/var/jb/usr/bin/uiopen --url file:///private/var/tmp/LocProbe.ipa
/redwood/bin/rwtouch wait 30
/var/jb/usr/bin/cat /private/var/tmp/tstore.txt
/var/jb/usr/bin/cat /private/var/tmp/inst.log
sleep 20
/var/jb/usr/bin/ls -l /var/containers/Bundle/Application >> /private/var/tmp/tstore.txt
/var/jb/usr/bin/cat /private/var/tmp/tstore.txt
