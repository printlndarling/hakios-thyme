# What location services do with the switch on (RC_JOBS=rc.jobs.locwork): turn it on as the
# mobile user, restart locationd, ask CoreLocation, see whether the privacy settings classes
# resolve, then let CoreLocation try to deliver fixes for 45 s before the Privacy page is opened
# for the shots.  No taps: a TCC prompt, if one appears, is left alone.
/redwood/bin/sleep_hold 300 &
/var/jb/usr/bin/uiopen sileo://package/wget
/redwood/bin/rwtouch wait 15
/redwood/bin/loc_test
/redwood/bin/loc_test enable
/redwood/bin/rwtouch wait 3
/redwood/bin/killby locationd 15
/redwood/bin/rwtouch wait 4
/redwood/bin/loc_test
/redwood/bin/clcheck
/redwood/bin/loc_test watch 45
/var/jb/usr/bin/uiopen prefs:root=Privacy&path=LOCATION
/redwood/bin/rwtouch wait 35
