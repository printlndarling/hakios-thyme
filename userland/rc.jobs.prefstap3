# Privacy & Security, reached by scrolling (RC_JOBS=rc.jobs.prefstap3): the
# root page shows no Privacy row until it is scrolled; one swipe of half a
# screen puts the row at 0.54/0.36 (locrow-140.png of the 08:55 run), and the
# tap opens the page the injected row lives on.
/redwood/bin/sleep_hold 240 &
/redwood/bin/rwtouch wait 10
/var/jb/usr/bin/uiopen --bundleid com.apple.Preferences
/redwood/bin/rwtouch wait 40
/redwood/bin/rwtouch swipe 0.5 0.85 0.5 0.35 400
/redwood/bin/rwtouch wait 3
/redwood/bin/rwtouch tap 0.54 0.36
/redwood/bin/rwtouch wait 90
