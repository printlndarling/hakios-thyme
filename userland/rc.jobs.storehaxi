# RC_JOBS=rc.jobs.storehaxi: the store's public-source path, with TrollBoard from haxi0's source.
#
# The install/update scenes used a source on the LAN so the layout was fixed.  This one uses
# the source TrollApps ships with: haxi0's list on raw.githubusercontent.com, whose featured
# rows are TrollBoard, Derootifier and TrollLock.  The IPA of TrollBoard (com.haxi0.
# TrollBoard-Reborn, 529,000 bytes) downloads from its GitHub release, so this run exercises
# the path a person takes with the store as it comes.  DNS=1 is built into the image.
/redwood/bin/net_test wait 20 joinfile /redwood/fw/network
/redwood/bin/net_test show dhcp en0 waitaddr en0 25 store wait 20
/redwood/bin/rwtouch wait 25
/var/jb/bin/sh /redwood/bin/hk-appinstall.sh TrollStore.app com.opa334.TrollStore
/redwood/bin/mcm_test com.opa334.TrollStore /Applications/TrollStore.app /redwood/share/tsldid/ldid
/var/jb/usr/bin/mkdir -p /var/mobile/Library/Preferences
/var/jb/usr/bin/cp /redwood/share/trollstore/com.opa334.TrollStore.plist /var/mobile/Library/Preferences/
/var/jb/usr/bin/chown 501:501 /var/mobile/Library/Preferences/com.opa334.TrollStore.plist
/var/jb/usr/bin/chmod 644 /var/mobile/Library/Preferences/com.opa334.TrollStore.plist
/var/jb/usr/bin/cp /redwood/share/trollstore/org.resonance.store.haxi.plist /var/mobile/Library/Preferences/org.resonance.store.plist
/var/jb/usr/bin/chown 501:501 /var/mobile/Library/Preferences/org.resonance.store.plist
/var/jb/usr/bin/chmod 644 /var/mobile/Library/Preferences/org.resonance.store.plist
/redwood/bin/hk_download http://192.168.0.104:8000/TrollApps.ipa /private/var/tmp/TrollApps.ipa
/var/jb/usr/bin/chmod 644 /private/var/tmp/TrollApps.ipa
/var/jb/Applications/TrollStore.app/trollstorehelper install custom /private/var/tmp/TrollApps.ipa
/redwood/bin/rwtouch wait 20
/var/jb/usr/bin/uicache -a
/var/jb/usr/bin/uiopen --bundleid org.resonance.store
/redwood/bin/rwtouch wait 35
# First featured row of haxi0's source: TrollBoard's GET.
/redwood/bin/rwtouch tap 0.86 0.27
/redwood/bin/rwtouch wait 22
/redwood/bin/rwtouch drag 0.9 0.872 0.9 0.42 900 500
/redwood/bin/rwtouch wait 5
/redwood/bin/rwtouch drag 0.1 0.872 0.1 0.42 900 500
/redwood/bin/rwtouch wait 8
/redwood/bin/rwtouch tap 0.5 0.77
/redwood/bin/rwtouch wait 5
/redwood/bin/rwtouch tap 0.5 0.79
/redwood/bin/rwtouch wait 15
/var/jb/usr/bin/ls -la /var/mobile/.TrollApps/tmp/ >> /private/var/tmp/storehaxi.txt
/redwood/bin/rwtouch wait 30
/var/jb/usr/bin/ls -l /var/containers/Bundle/Application >> /private/var/tmp/storehaxi.txt
/var/jb/usr/bin/uicache -a
/var/jb/usr/bin/uiopen --bundleid com.haxi0.TrollBoard-Reborn
/redwood/bin/rwtouch wait 30
/var/jb/usr/bin/ls -l /var/containers/Bundle/Application >> /private/var/tmp/storehaxi.txt
/var/jb/usr/bin/cat /private/var/tmp/storehaxi.txt
