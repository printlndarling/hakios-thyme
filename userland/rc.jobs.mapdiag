# RC_JOBS=rc.jobs.mapdiag: install the map IPA staged by tools/map-run.sh and start it.
#
# The host stages target.ipa and target.txt in the LAN directory it serves; this
# scene puts TrollStore's helper where it runs from, then hk-mapipa.sh verifies the
# digest, installs, launches by bundle id and collects the crash reports.  No app is
# baked into the image: what runs here is whatever the operator staged, and a
# FairPlay-encrypted IPA is refused on the host before the image is even built.
/redwood/bin/net_test wait 20 joinfile /redwood/fw/network
/redwood/bin/net_test show dhcp en0 waitaddr en0 25 store wait 20
/redwood/bin/rwtouch wait 25
/var/jb/bin/sh /redwood/bin/hk-appinstall.sh TrollStore.app com.opa334.TrollStore
/redwood/bin/mcm_test com.opa334.TrollStore /Applications/TrollStore.app /redwood/share/tsldid/ldid
/var/jb/bin/sh /redwood/bin/hk-mapipa.sh http://192.168.0.104:8000
# SpringBoard may auto-lock while the 198 MB IPA downloads and TrollStore installs
# (especially with modem cold-boot). Wake and unlock before bringing the app forward,
# then wait 15 s (short enough to avoid iOS auto-dim) and tap 同意 (0.664, 0.671) twice.
/redwood/bin/rwtouch tap 0.5 0.5 wait 2 notify com.hakios.unlock wait 2 swipe 0.5 0.985 0.5 0.3 200 wait 2
/var/jb/usr/bin/uiopen --bundleid com.baidu.map
/redwood/bin/rwtouch wait 15 tap 0.664 0.671 wait 5 tap 0.664 0.671
# Dismiss system alerts (Location, Notifications, ATT) and Baidu Maps' 隐私保护指引
# in clean order without tapping the 新人福利 promo CTA (立即启程 at y=0.73), then
# close the 新人福利 modal via its X circle (0.500, 0.814, measured from bmap3-t200.png)
# so the live main map with the current CoreLocation dot is unobstructed.
/redwood/bin/rwtouch wait 4 tap 0.672 0.565 wait 3 tap 0.5 0.694 wait 3 tap 0.5 0.590 wait 3 tap 0.672 0.565 wait 3 tap 0.5 0.694 wait 3 tap 0.337 0.591 wait 3 tap 0.337 0.591 wait 4 tap 0.5 0.814 wait 4 tap 0.5 0.814 wait 20
# No kill and second launch (the run of 042702: a restart brings an interstitial and ATT
# again, and the sweep's taps on the map walked it into a 房源 page and then the 问一问AI
# page -- the tap meant for the interstitial's close button, x 0.5 y 0.776, is the AI bubble
# there).  The sweep stops here: a tap that finds no dialog lands on the map, whose POI card
# is over the bottom of it, not over the map.
/var/jb/usr/bin/cat /private/var/tmp/mapipa.txt
