# The master switch locationd keeps in its own preferences (RC_JOBS=rc.jobs.lockey):
# locationd runs as mobile and reads /var/mobile/Library/Preferences/com.apple.locationd.plist,
# so loc_test now drops to uid 501 before writing "LocationServicesEnabledIn8.0".  The key is
# written first as a boolean, then (if CoreLocation still says off) as a number, each followed by
# a locationd restart; the Privacy page is opened at the end for the shots. No taps.
/redwood/bin/sleep_hold 250 &
/var/jb/usr/bin/uiopen sileo://package/wget
/redwood/bin/rwtouch wait 20
/redwood/bin/loc_test
/redwood/bin/loc_test enable
/redwood/bin/rwtouch wait 3
/redwood/bin/killby locationd 15
/redwood/bin/rwtouch wait 5
/redwood/bin/loc_test
/redwood/bin/loc_test enablenum
/redwood/bin/rwtouch wait 3
/redwood/bin/killby locationd 15
/redwood/bin/rwtouch wait 5
/redwood/bin/loc_test
/var/jb/usr/bin/uiopen prefs:root=Privacy&path=LOCATION
/redwood/bin/rwtouch wait 40
