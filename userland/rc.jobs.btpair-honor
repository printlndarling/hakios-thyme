# Keep Wi-Fi active, then try the named HONOR peer instead of the weak anonymous
# Accessory. The second row is selected after Bluetooth discovery settles.
/redwood/bin/net_test wait 20 joinfile /redwood/fw/network
/redwood/bin/net_test show dhcp en0 waitaddr en0 25
/redwood/bin/battery_test open prefs:root=Bluetooth
/redwood/bin/rwtouch wait 55
/redwood/bin/rwtouch tap 0.5 0.40
/redwood/bin/rwtouch wait 60
