# HakiOS fragment: the Xiaomi Mi 10S (thyme) -- what is true of this device and of no other.
# Every phone driver is left out until it has been made to work here; the arguments only those drivers read go too.
CONFIG_DEVICE="thyme"
CONFIG_HAKIOS_THYME_AUDIO=y
CONFIG_HAKIOS_THYME_SLPI=y
# CONFIG_HAKIOS_ADSP is not set
# CONFIG_HAKIOS_SPEAKER is not set
# CONFIG_HAKIOS_SOUND is not set
# CONFIG_HAKIOS_MIC is not set
CONFIG_HAKIOS_THYME_BT=y
# CONFIG_HAKIOS_BT is not set
# CONFIG_HAKIOS_CAMERA is not set
CONFIG_HAKIOS_THYME_CAMERA=y
# CONFIG_HAKIOS_TORCH is not set
CONFIG_HAKIOS_THYME_TORCH=y
# CONFIG_HAKIOS_SOCINFO is not set
CONFIG_HAKIOS_THYME_ADRENO=y
CONFIG_HAKIOS_THYME_DISPLAY=y
# CONFIG_HAKIOS_ADRENO is not set
CONFIG_HAKIOS_THYME_HAPTIC=y
# CONFIG_HAKIOS_HAPTIC is not set
CONFIG_HAKIOS_THYME_INPUT=y
# CONFIG_HAKIOS_GOODIX is not set
# CONFIG_HAKIOS_BUTTONS is not set
# CONFIG_HAKIOS_QMI is not set
# CONFIG_HAKIOS_MODEM is not set
CONFIG_HAKIOS_BATTERY=y
CONFIG_HAKIOS_THYME_POWER=y
# CONFIG_HAKIOS_CPUFREQ is not set
# CONFIG_HAKIOS_THERMAL is not set
# the PMIC bus and its power-on block: the modem's warm reset (qpnp_pon_modem_pwr_off)
# and the read-only inventory (pmic=1) both live here; inert until a driver asks
CONFIG_HAKIOS_PMIC=y
CONFIG_HAKIOS_BATTGUARD=y
# CONFIG_HAKIOS_UFS is not set
CONFIG_HAKIOS_THYME_WIFI=y
# CONFIG_HAKIOS_WIFI is not set
CONFIG_TOUCHSCREEN=y
CONFIG_GPU=y
# the panel's own 90 Hz timing sequence is sent by the display driver; the
# framebuffer is clamped back to 60 if that sequence is not accepted
CONFIG_FB_HZ=90
CONFIG_ADSP=y
CONFIG_SOUND=4
CONFIG_MIC=4
CONFIG_WIFI=y
# CONFIG_MODEM is not set
# CONFIG_MODEM_AGAIN is not set
# CONFIG_FIRMWARE is "device" in the common kernel: say "none" here until this device's firmware is pulled
CONFIG_BATTERY=1
CONFIG_BATTERY_STOP=25
CONFIG_BATTERY_STOP_POLL=30
CONFIG_BUTTONS=y
CONFIG_UMI_HAPTIC=5
CONFIG_BOOTARGS="adsp_umi=1"
CONFIG_BT=y
CONFIG_CPUFREQ=y
CONFIG_THERMAL=y
CONFIG_THERMAL_STOP=95
